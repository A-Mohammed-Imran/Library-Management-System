# Secret key for Flask sessions/tokens
SECRET_KEY=your_super_secret_key_here

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=secure_admin_password

# Database Path (Optional, defaults to backend/library.db)
# DATABASE_PATH=

# Allowed CORS Origins (e.g., https://your-frontend.netlify.app)
CORS_ORIGINS=*

# Port for the backend
PORT=5000
